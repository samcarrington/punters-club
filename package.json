{
  "name": "punters-club",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "enrich:shows": "tsx scripts/enrich-shows.ts",
    "enrich:playlists": "tsx scripts/enrich-playlists.ts",
    "enrich:next-show": "tsx scripts/enrich-next-show.ts",
    "enrich": "pnpm run enrich:shows && pnpm run enrich:playlists && pnpm run enrich:next-show",
    "build": "astro build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:next-show:remote": "RUN_REMOTE_TESTS=1 vitest run src/lib/next-show.remote.test.ts",
    "verify:structured-data": "tsx scripts/verify-structured-data.ts",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@iconify-json/gridicons": "1.2.5",
    "@iconify-json/lucide": "1.2.117",
    "@vitest/coverage-v8": "4.1.10",
    "astro": "7.2.0",
    "tsx": "4.22.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "astro-icon": "1.1.5",
    "sharp": "^0.35.3"
  }
}
