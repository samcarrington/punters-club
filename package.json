{
  "name": "punters-club",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "enrich:shows": "tsx scripts/enrich-shows.ts",
    "enrich:playlists": "tsx scripts/enrich-playlists.ts",
    "enrich:next-show": "tsx scripts/enrich-next-show.ts",
    "enrich": "pnpm run enrich:shows && pnpm run enrich:playlists && pnpm run enrich:next-show",
    "build": "astro build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:next-show:remote": "RUN_REMOTE_TESTS=1 vitest run src/lib/next-show.remote.test.ts",
    "verify:structured-data": "tsx scripts/verify-structured-data.ts",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@iconify-json/gridicons": "1.2.5",
    "@iconify-json/lucide": "1.2.129",
    "@vitest/coverage-v8": "4.1.11",
    "astro": "7.3.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "astro-icon": "1.2.0",
    "sharp": "^0.35.4"
  }
}
