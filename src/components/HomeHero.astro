---
import NextShow from "../components/NextShow.astro";
import { SITE } from "../lib/constants";
---
<section class="hero marquee-hero" aria-labelledby="hero-title">
  <div class="hero-content">
    <p class="hero-kicker" style="display: none">
      Disco and House to modern electronic on Radio Waters
    </p>
    <h1 id="hero-title">For the love of music</h1>
    <p class="hero-copy">
      A husband-and-wife duo with a dancer's ear, a punter's instinct, and a
      passion for music. Every show is a warm blend of disco, house,
      and electronica. With the occasional left-field gem.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={SITE.latestShowHash}>Play latest show</a>
      <a class="btn btn-secondary" href={SITE.showsPath}>Browse archive</a>
    </div>
  </div>
  <aside class="hero-next-show-rail" aria-label="Next show">
    <NextShow />
  </aside>
</section>
